<resources>
    <!--
      Short-edge cutout mode lets the reader draw the band beside a camera cutout itself. The page keeps
      clear of the cutout through window insets, and the band takes the document's own background colour
      and dims with the tools scrim instead of staying a separate system-coloured strip.
    -->
    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
